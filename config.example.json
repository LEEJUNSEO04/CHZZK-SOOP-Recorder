{
  "paths": {
    "base_dir": ".",
    "temp_dir": "temp",
    "merged_dir": "merged",
    "logs_dir": "logs",
    "failed_dir": "failed",
    "drive_dir": "recordings"
  },
  "recording": {
    "default_quality": "best",
    "check_interval_sec": 60,
    "retry_delay_sec": 15,
    "min_file_size_mb": 5,
    "min_free_gb": 20,
    "delete_ts_after_success": true,
    "move_mp4_to_drive": true,
    "max_check_workers": 5,
    "title_check_interval_sec": 60,
    "segment_duration_sec": 3600,
    "segment_post_check_delay_sec": 8,
    "postprocess_wait_timeout_sec": 3600,
    "delete_ts_after_part_success": true,
    "offline_confirm_checks": 3,
    "offline_confirm_interval_sec": 30,
    "title_include_rules": {}
  },
  "database": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 3306,
    "user": "recorder_user",
    "password": "CHANGE_ME",
    "database": "recorder",
    "charset": "utf8mb4"
  },
  "youtube": {
    "enabled": false,
    "privacy_status": "private",
    "category_id": "20",
    "delete_after_success": false,
    "delete_split_parent_after_children_success": false,
    "poll_interval_sec": 60,
    "upload_existing_done_records": false,
    "client_secret_path": "client_secret.json",
    "token_pickle_path": "token.pickle",
    "token_json_path": "token.json",
    "title_template": "{streamer_name}_{started_at}",
    "description_template": "자동 녹화 영상\n스트리머: {streamer_name}\n녹화 시작: {started_at}",
    "delete_parts_after_success": false,
    "recover_uploading_on_start": true,
    "upload_requeue_on_failure": true,
    "upload_max_retries": 20,
    "upload_retry_delay_sec": 10,
    "upload_retry_max_delay_sec": 60,
    "upload_chunk_size_mb": 64,
    "max_video_size_gb": 256,
    "try_full_upload_over_12h": true,
    "auto_split_too_long": true,
    "split_segment_seconds": 21600,
    "split_output_dir": "split_upload",
    "concurrent_uploads": 2,
    "reduce_to_one_at_active_recordings": 6,
    "upload_stall_warn_sec": 600,
    "upload_schedule": {
      "enabled": false,
      "start": "00:00",
      "end": "23:59",
      "pause_active_upload": false
    },
    "thumbnail": {
      "enabled": false,
      "output_dir": "thumbnails/auto",
      "font_path": "C:/Windows/Fonts/malgunbd.ttf",
      "retry_interval_sec": 600,
      "rate_limit_retry_sec": 21600,
      "transient_retry_sec": 3600,
      "import_prepared_batches": false,
      "ai_enabled": false,
      "ai_model": "gpt-image-2",
      "ai_quality": "medium",
      "ai_size": "1536x864",
      "ai_output_dir": "thumbnails/ai",
      "ai_request_timeout_sec": 420,
      "openai_key_file": "logs/openai_image_api_key.dpapi"
    }
  },
  "chat_overlay": {
    "enabled": false,
    "require_chat_for_upload": false,
    "width": 1920,
    "height": 1080,
    "chat_width": 420,
    "font_size": 26,
    "max_lines": 26,
    "crf": 23,
    "preset": "veryfast",
    "delete_original_after_overlay_upload": false
  },
  "sweeper": {
    "enabled": true,
    "scan_interval_sec": 30,
    "stable_seconds": 300,
    "min_age_seconds": 120,
    "min_size_mb": 5.0
  },
  "merge_worker": {
    "enabled": true,
    "scan_interval_sec": 120,
    "idle_after_last_part_sec": 7200,
    "require_stream_offline": true,
    "offline_confirm_checks": 3,
    "offline_confirm_interval_sec": 30,
    "auto_stitch_enabled": true,
    "auto_stitch_gap_sec": 3600,
    "auto_stitch_move_parts": false,
    "staging_dir": "recordings/_merge_staging",
    "allow_skip_unrecoverable_parts": true,
    "max_unrecoverable_part_skips": 2,
    "delete_parts_after_merge": false,
    "parts_cleanup_min_ratio": 0.0
  }
}
